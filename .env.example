# ===== 机器人协议 =====
# 开发期用 mock，不依赖真号；上线时改为 wechaty-puppet-wechat4u 或 wechaty-puppet-service
WECHATY_PUPPET=wechaty-puppet-mock
WECHATY_NAME=wechat-assistant

# ===== 付费协议 token（仅 wechaty-puppet-service 需要）=====
# WECHATY_PUPPET_SERVICE_TOKEN=

# ===== LLM 提供方 =====
# 可选值（来自 src/llm/providers.ts 注册表）：
#   mock / deepseek / qwen / glm / kimi / doubao / minimax / baichuan
#   openai / claude / gemini / arkcli
# 缺省 mock。切换 provider 改这一行即可，baseUrl/apiKeyEnv/model 都有 preset 默认值。
LLM_PROVIDER=mock

# 通用覆盖（可选，优先级高于 preset 与 config/ai.json）：
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY_ENV=      # 自定义 key 存放的环境变量名

# ===== 国内厂商 API Key（按所选 provider 填对应的）=====
# deepseek — https://api.deepseek.com
# DEEPSEEK_API_KEY=
# qwen     — 阿里 DashScope
# DASHSCOPE_API_KEY=
# glm      — 智谱 BigModel
# ZHIPU_API_KEY=
# kimi     — 月之暗面 Moonshot
# MOONSHOT_API_KEY=
# doubao   — 火山方舟标准推理接入点
# ARK_API_KEY=
# minimax
# MINIMAX_API_KEY=
# baichuan — 百川
# BAICHUAN_API_KEY=

# ===== 国外厂商 API Key =====
# openai
# OPENAI_API_KEY=
# claude — Anthropic
# ANTHROPIC_API_KEY=
# gemini — Google
# GEMINI_API_KEY=

# ===== 火山方舟 Coding Plan（provider=arkcli）=====
# 走本机 arkcli CLI 登录态，**不需要**也**不应**设置 ARK_API_KEY / ARK_BASE_URL
# （那会让 arkcli 进入「自定义端点 + API Key」模式，与登录态互斥）。
# 只需先 arkcli auth login，然后：
# LLM_PROVIDER=arkcli
# LLM_MODEL=deepseek-v4.1-flash

# ===== 旧变量兼容（provider=ark/openai 时仍生效，推荐用上面的通用覆盖）=====
# ARK_MODEL=doubao-seed-1-6-250615
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 管理台 =====
ADMIN_PORT=3000
# ADMIN_TOKEN=
