# ===== 机器人协议 =====
# 开发期用 mock，不依赖真号；上线时改为 wechaty-puppet-wechat4u 或 wechaty-puppet-service
WECHATY_PUPPET=wechaty-puppet-mock
WECHATY_NAME=wechat-assistant

# ===== 付费协议 token（仅 wechaty-puppet-service 需要）=====
# WECHATY_PUPPET_SERVICE_TOKEN=

# ===== LLM 提供方（阶段 3 使用，阶段 0 可不填）=====
LLM_PROVIDER=mock
# LLM_PROVIDER=ark          # 火山引擎方舟
# LLM_PROVIDER=openai       # OpenAI 兼容端点

# ===== 火山方舟（provider=ark 时必填）=====
# ARK_API_KEY=
# ARK_MODEL=doubao-seed-1-6-250615
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== OpenAI 兼容（provider=openai 时必填）=====
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ===== 管理台（阶段 4 使用）=====
ADMIN_PORT=3000
# ADMIN_TOKEN=
